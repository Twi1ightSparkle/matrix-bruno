meta {
  name: List users
  type: http
  seq: 1
}

get {
  url: {{protocol}}://{{masAdminEndpoint}}/api/admin/v1/users
  body: none
  auth: inherit
}

params:query {
  ~page[before]: 
  ~page[after]: 
  ~page[first]: 
  ~page[last]: 
  ~count: true
  ~filter[admin]: false
  ~filter[status]: one of active,locked,deactivated
  ~filter[legacy-guest]: false
  ~filter[search]: username
  ~filter[active-oauth2-client]: 01KXDZ57BA54PQ8ZHVQG1GA5VW
  ~filter[has-active-oauth2-session]: true|false
  ~filter[has-active-compat-session]: true|false
}
