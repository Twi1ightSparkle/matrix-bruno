meta {
  name: Check the status of a redaction process
  type: http
  seq: 15
}

get {
  url: {{protocol}}://{{delegatedURL}}/_synapse/admin/v1/user/redact_status/:redactId
  body: json
  auth: inherit
}

params:path {
  redactId: {{redactId}}
}

docs {
  <https://element-hq.github.io/synapse/latest/admin_api/user_admin_api.html#check-the-status-of-a-redaction-process>
}
